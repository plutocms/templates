# The env of the demo build (scripts/build-demos.mjs). The shop is fiction.
NUXT_PUBLIC_WEBSITE_NAME=Harbour Pantry
# No Supabase project: server/middleware/demo-api.ts answers the public API from
# demo-fixture.json. The client of Supabase needs a URL and a key to start, and
# the site pages send it no request.
SUPABASE_URL=https://demo.invalid
SUPABASE_KEY=demo
